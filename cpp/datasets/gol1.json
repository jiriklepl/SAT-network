{
  "instructions": 6,
  "num_inputs": 7,
  "num_outputs": 2,
  "forall": [
    { "var": "left", "range": [0, 4] },
    { "var": "center", "range": [0, 3] },
    { "var": "right", "range": [0, 4] },
    { "var": "alive", "values": [1, 0] }
  ],
  "let_row": {
    "sum": "left + center + right",
    "carry": "((left & 1) + (center & 1) + (right & 1)) / 2"
  },
  "inputs": [
    "bits(left, 2)",
    "bits(center, 2)",
    "bits(right, 2)",
    "bit(alive)"
  ],
  "outputs": [
    "bit(((sum | alive) % 2) == 1)",
    "bit(carry == 1)"
  ]
}

