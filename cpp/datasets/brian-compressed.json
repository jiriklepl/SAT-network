{
  "instructions": 10,
  "num_inputs": 8,
  "num_outputs": 2,
  "forall": [
    { "var": "center", "range": [0, 3] },
    { "var": "left_count", "range": [0, 4] },
    { "var": "center_count", "range": [0, 3] },
    { "var": "right_count", "range": [0, 4] }
  ],
  "let_row": {
    "n": "left_count + center_count + right_count",
    "next_state": "center == 1 ? 2 : (center == 2 ? 0 : (n == 2 ? 1 : 0))"
  },
  "inputs": [
    "bits(left_count, 2)",
    "bits(center_count, 2)",
    "bits(right_count, 2)",
    "bits(center, 2)"
  ],
  "outputs": [
    "bits(next_state, 2)"
  ]
}

