{
  "instructions": 8,
  "num_inputs": 6,
  "num_outputs": 2,
  "forall": [
    { "var": "center", "range": [0, 4] },
    { "var": "left_count", "range": [0, 2] },
    { "var": "vertical_count", "range": [0, 3] },
    { "var": "right_count", "range": [0, 2] }
  ],
  "let_row": {
    "has_fire_neighbor": "(left_count + vertical_count + right_count) > 0",
    "next_state": "center == 1 ? (has_fire_neighbor ? 2 : 1) : (center == 2 ? 3 : (center == 3 ? (has_fire_neighbor ? 3 : 0) : 0))"
  },
  "inputs": [
    "bits(left_count, 1)",
    "bits(vertical_count, 2)",
    "bits(right_count, 1)",
    "bits(center, 2)"
  ],
  "outputs": [
    "bits(next_state, 2)"
  ]
}

